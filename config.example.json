{
  "streamer_name": "主播名稱（填這裡）",
  "language": "zh",
  "whisper": {
    "model": "large-v3",
    "device": "auto",
    "compute_type": "auto",
    "initial_prompt": "以下是台灣中文遊戲直播的逐字稿。",
    "hotwords": [],
    "_refine_說明": "refine_transcript.py 重轉選定段落用的模型；refine_separate 為 true 時先用 Demucs 分離人聲",
    "refine_model": "large-v3",
    "refine_separate": true
  },
  "chinese_convert": "s2twp",
  "_text_replacements_說明": "轉錄後固定替換常見錯字，例如主播名被聽成同音字：{\"小銘\": \"小明\"}",
  "text_replacements": {},

  "separation": {"model": "htdemucs", "device": "auto"},

  "chat_offset_sec": 0,

  "signals": {
    "window_sec": 10,
    "chat_lag_sec": 8,
    "min_gap_sec": 30,
    "candidates_per_hour": 12,
    "min_candidates": 15,
    "_weights_說明": "visual／scream／laugh 預設 0：實測對話題、金句型的精華沒有穩定幫助，只在候選的訊號列顯示給 Claude 參考。反應型頻道可試 0.3。",
    "weights": {"chat": 1.0, "keywords": 1.2, "audio": 0.8, "superchat": 0.5, "speech": 0.4,
                "visual": 0, "scream": 0, "laugh": 0}
  },

  "chat_keywords": {
    "草": 1.0, "www": 1.0, "笑死": 1.5, "XD": 1.0, "哈哈": 1.0, "哈哈哈": 1.2,
    "？？？": 1.2, "???": 1.2, "好扯": 1.2, "靠北": 1.0, "靠杯": 1.0, "母湯": 1.0,
    "可憐": 0.8, "8787": 1.0, "87": 0.6, "好可愛": 1.0, "可愛": 0.6, "暴斃": 1.2,
    "神": 0.8, "太神": 1.2, "猛": 0.6, "欸": 0.5, "打給": 0.8, "切片": 1.5,
    "剪": 0.8, "精華": 1.5, "LUL": 1.0, "KEKW": 1.0, "😂": 1.0, "🤣": 1.0
  },
  "speech_keywords": {
    "等一下": 1.0, "不要": 0.8, "欸欸欸": 1.2, "啊啊啊": 1.2, "救命": 1.2,
    "哈哈哈": 0.8, "什麼": 0.5, "怎麼可能": 1.0, "完了": 1.0, "幹嘛": 0.6
  },

  "vertical_layout": {
    "mode": "template",
    "output_size": [1080, 1920],

    "_template_說明": "template 模式＝固定版型：上方品牌條、中間內容視窗、下方花紋條。content_box 是範例值，請依自己的 PNG 調整。",
    "template_png": "",
    "content_box": [0, 328, 1080, 1168],
    "background_color": "0x202020",
    "default_crop": "game",
    "_crop_說明": "裁切以原始直播 1920x1080 座標計，[x,y,寬,高]。需用 frames.py --calibrate 校正。可加 pip：把模型小窗疊在內容左上。",
    "crop_presets": {
      "game": [420, 0, 1000, 1080],
      "face": [1440, 560, 480, 520],
      "wide": [0, 0, 1920, 1080],
      "game_pip": {"region": [300, 0, 1000, 1080], "pip": {"region": [1440, 560, 480, 520], "at": [0, 0, 380]}}
    },

    "game_crop": [240, 0, 1440, 1080],
    "avatar_crop": [1380, 420, 540, 660],
    "game_height_ratio": 0.58
  },

  "_avatar_tracks_說明": "avatar_tracks.py：依 Premiere 匯出 XML 裡每位說話者的字卡軌，在空軌放頭像。連動來賓每場不同時，可改用 --map 或每場的 config_<日期>.json。image 可省略：目標軌已有手動放好的頭像時沿用它的圖和位置／縮放；沒有時建議用序列大小（1920x1080）的透明 PNG，頭像已擺在定位。",
  "avatar_tracks": {
    "gap_merge_sec": 0.5,
    "map": [
      {"from": "V5", "to": "V2", "name": "來賓A", "image": "頭像/來賓A.png"},
      {"from": "V6", "to": "V3", "name": "來賓B", "image": "頭像/來賓B.png"}
    ]
  },

  "_limits_說明": "validate_selections.py 的建議長度（秒），超出只會提醒，不會擋下出片。",
  "limits": {"vertical_sec": [18, 35], "horizontal_sec": [120, 240]},

  "subtitles": {
    "vertical_max_chars": 10,
    "horizontal_max_chars": 12,
    "pause_split_sec": 0.5
  },

  "encode": {
    "preset": "veryfast",
    "crf": 18,
    "audio_bitrate": "192k",
    "loudness_lufs": -14
  }
}
